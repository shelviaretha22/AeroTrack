# Rahasia dan lingkungan
/.env
/.env.*
!/.env.example

# Basis data lokal dan file unggahan privat (dokumen, TTD, foto profil)
/database/*.sqlite
/database/*.sqlite-journal
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore

# Dependensi dan hasil build
/vendor
/node_modules
/public/build
/public/hot
/public/storage

# Cache, log, dan sesi
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*.php

# Editor dan sistem operasi
/.idea
/.vscode
.DS_Store
Thumbs.db
